# Required for encrypted secret storage.
# Generate a real value with the command in docs/setup/installation.md.
ASSISTANTMD_SECRETS_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY

# Deployment settings used by docker-compose.yml.
TZ=UTC
ASSISTANTMD_AUTH_MODE=disabled

# Required by owner_token and trusted_proxy modes. Generate a different value
# from ASSISTANTMD_SECRETS_KEY with: openssl rand -hex 32
# ASSISTANTMD_AUTH_SECRET=REPLACE_WITH_RANDOM_AUTH_SECRET

# Optional canonical origin for reverse-proxy deployments and external callbacks.
# Use the browser-visible origin only, with no path, query string, or fragment.
# ASSISTANTMD_PUBLIC_URL=https://assistant.example.com

# Optional advanced mode. This activates both the Compose service and the
# AssistantMD capability after restart.
# COMPOSE_PROFILES=advanced
# Non-Compose deployments can set ASSISTANTMD_EXECUTION_MODE=advanced instead.
# ASSISTANTMD_SHELL_HOST=advanced-shell
# ASSISTANTMD_SHELL_PORT=2222
# ASSISTANTMD_SHELL_USER=advanced-shell

# Optional: pin both AssistantMD images to the same release tag.
# ASSISTANTMD_IMAGE_TAG=v1.2.3
