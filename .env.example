# Required for encrypted secret storage.
# Generate a real value with the command in docs/setup/installation.md.
ASSISTANTMD_SECRETS_KEYS='{"1":"REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY"}'
ASSISTANTMD_SECRETS_ACTIVE_KEY_VERSION=1

# Optional development-only allowance for HTTP MCP servers on local/private networks.
# Public MCP servers always require HTTPS. `scripts/dev run` enables this automatically.
# ASSISTANTMD_MCP_ALLOW_INSECURE_HTTP=true
