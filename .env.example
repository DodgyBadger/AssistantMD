# Required for encrypted secret storage.
# Generate a real value with the command in docs/setup/installation.md.
ASSISTANTMD_SECRETS_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY

# Optional canonical origin for reverse-proxy deployments and external callbacks.
# Use the browser-visible origin only, with no path, query string, or fragment.
# ASSISTANTMD_PUBLIC_URL=https://assistant.example.com
