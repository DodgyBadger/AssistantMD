# Default Docker Compose configuration that pulls the published GHCR image.
# Copy this file to docker-compose.yml and run: docker compose up -d

services:
  assistant:
    image: ghcr.io/dodgybadger/assistantmd:${ASSISTANTMD_IMAGE_TAG:-latest}
    container_name: assistantMD
    restart: unless-stopped
    init: true
    ports:
      - "127.0.0.1:8000:8000"    # FastAPI - localhost only
    volumes:
      - /absolute/path/to/your/vaults:/app/data   # Pre-create path on the left of the colon & ensure owned by your user
      - ./system:/app/system                      # Pre-create path on the left of the colon & ensure owned by your user
      - advanced_shell_client_identity:/run/assistantmd-shell/client-identity
      - advanced_shell_client_public:/run/assistantmd-shell/client-public
      - advanced_shell_host_public:/run/assistantmd-shell/host-public:ro
    env_file:
      - path: .env
        required: false
    # .env also accepts ASSISTANTMD_PUBLIC_URL for reverse-proxy deployments.
    environment:
      - TZ=UTC
      - API_PORT=8000
      - ASSISTANTMD_SHELL_KEY_ROOT=/run/assistantmd-shell/client-identity
      # The host-loopback port is the boundary for this unprotected local example.
      - ASSISTANTMD_AUTH_MODE=disabled  # Use trusted_proxy or owner_token for authenticated ingress
    shm_size: "1gb"
    
    # Standard browser-capable profile: at least 2G available to AssistantMD.
    # For an approximately 1G lightweight deployment, add `browser` to
    # `disabled_tools` rather than lowering this limit and relying on Chromium.
    # shm_size is a separate shared-memory ceiling, not a memory reservation.
    deploy:
      resources:
        limits:
          memory: 2G
          cpus: '1.0'
        reservations:
          memory: 1G
          cpus: '0.5'
    
    # Security options
    security_opt:
      - no-new-privileges:true

    # Health check
    # healthcheck:
    #   test: ["CMD", "curl", "-f", "http://localhost:${API_PORT:-8000}/api/health"]
    #   interval: 120s
    #   timeout: 10s
    #   retries: 3
    #   start_period: 40s

  assistantmd-shell:
    profiles: ["advanced"]
    image: ghcr.io/dodgybadger/assistantmd-shell:${ASSISTANTMD_IMAGE_TAG:-latest}
    init: true
    restart: unless-stopped
    networks:
      default:
        aliases:
          - assistantmd-shell
    volumes:
      - type: volume
        source: advanced_shell_host_identity
        target: /run/assistantmd-shell/host-identity
      - type: volume
        source: advanced_shell_host_public
        target: /run/assistantmd-shell/host-public
      - type: volume
        source: advanced_shell_client_public
        target: /run/assistantmd-shell/client-public
        read_only: true
      - type: volume
        source: advanced_shell_workspace
        target: /workspace
      - type: volume
        source: advanced_shell_home
        target: /home/assistantmd-shell
    read_only: true
    tmpfs:
      - /run/sshd:size=1m,mode=0755
      - /tmp:size=64m,mode=1777
    cap_drop:
      - ALL
    cap_add:
      - SETGID
      - SETUID
      - SYS_CHROOT
    security_opt:
      - no-new-privileges:true
    pids_limit: 128
    mem_limit: 512m
    cpus: 1.0
    healthcheck:
      test: ["CMD-SHELL", "sshd -t -f /etc/ssh/sshd_config"]
      interval: 10s
      timeout: 3s
      retries: 6

volumes:
  advanced_shell_client_identity:
  advanced_shell_client_public:
  advanced_shell_home:
  advanced_shell_host_identity:
  advanced_shell_host_public:
  advanced_shell_workspace:
